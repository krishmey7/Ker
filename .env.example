DEBUG=True
SECRET_KEY=.........
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
# En prod : domaine(s) réel(s), sans espace. En dev (config.settings.dev), tout hôte est accepté.
ALLOWED_HOSTS=localhost,127.0.0.1

# IA — Groq (prioritaire) : https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=........
GROQ_MODEL=qwen-3.6-27b
AI_REQUEST_TIMEOUT=30

# IA — Gemini (optionnel, legacy)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# KibaWallet — Mobile Money (USD/CDF), dashboard https://kibawallet.vercel.app
KIBA_API_BASE_URL=https://kibawallet-api.onrender.com
KIBA_PUBLIC_KEY=......
KIBA_SECRET_KEY=.......
KIBA_WEBHOOK_SECRET=
